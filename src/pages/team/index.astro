---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../utils/paths";
---
<Base title="Team - Nostr Dev Kit" description="The team maintaining Nostr Dev Kit.">
  <main class="page">
    <section class="page-hero">
      <p class="eyebrow">Team</p>
      <h1>The people maintaining Nostr Dev Kit.</h1>
      <p>Active maintainers of the project.</p>
    </section>

    <section class="team-list" aria-label="Active maintainers">
      <article class="team-member glow-card reveal">
        <img class="member-photo" src={withBase("/assets/yuki.jpg")} alt="Photo of Yuki Kishimoto" width="72" height="72" />
        <div class="member-body">
          <span class="member-role">Lead maintainer</span>
          <h2>Yuki Kishimoto</h2>
          <p class="member-bio">Started the project as rust-nostr and leads the development of the core and its libraries.</p>
          <div class="member-links">
            <a href="mailto:yukikishimoto@protonmail.com">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
              Email
            </a>
            <a href="https://yukikishimoto.com/PGP.asc">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              PGP
            </a>
            <a href="https://yukikishimoto.com">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              Website
            </a>
          </div>
        </div>
      </article>

      <article class="team-member glow-card reveal">
        <img class="member-photo" src={withBase("/assets/awiteb.png")} alt="Avatar of Awiteb" width="72" height="72" />
        <div class="member-body">
          <span class="member-role">Maintainer</span>
          <h2>Awiteb</h2>
          <p class="member-bio">Project maintainer and contributor.</p>
          <div class="member-links">
            <a href="mailto:a@4rs.nl">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
              Email
            </a>
            <a href="https://4rs.nl/pgp/">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
              </svg>
              PGP
            </a>
            <a href="https://4rs.nl">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              Website
            </a>
          </div>
        </div>
      </article>
    </section>
  </main>
</Base>
