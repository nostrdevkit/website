---
import Base from "../layouts/Base.astro";
import { site } from "../config/site";
import { withBase } from "../utils/paths";
---
<Base>
  <main id="main">
    <section class="hero" aria-labelledby="hero-title">
      <p class="eyebrow">Nostr Dev Kit</p>
      <h1 id="hero-title">Nostr for <span class="shimmer">builders</span>.</h1>
      <p class="hero-text">
        Everything you need to build Nostr software — simple APIs, an efficient core, and a library for every stack.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button button-primary" href={site.docsUrl}>Read the docs</a>
        <a class="button button-secondary" href={site.githubUrl}>View GitHub</a>
      </div>
      <p class="hero-meta">Formerly rust-nostr · MIT · maintained in the open</p>
    </section>

    <section class="section" aria-labelledby="why-title">
      <div class="section-heading reveal">
        <p class="eyebrow">Why Nostr Dev Kit?</p>
        <h2 id="why-title">The base layer for building on Nostr.</h2>
      </div>
      <div class="why-grid">
        <div class="stack glow-card reveal">
          <div class="slab slab-app">
            <span class="slab-tag">yours</span>
            <h3>Your application</h3>
            <p>Clients, bots, relays, services — whatever you're building.</p>
          </div>
          <div class="slab-join" aria-hidden="true"></div>
          <div class="slab slab-libs">
            <h3>A library for every stack</h3>
            <p>One API surface per language, on every runtime you target.</p>
            <div class="slab-chips">
              <span class="chip">Rust</span>
              <span class="chip">Python</span>
              <span class="chip">Kotlin</span>
              <span class="chip">Swift</span>
              <span class="chip">WASM</span>
              <a class="chip chip-more" href={site.docsUrl}>+ many more</a>
            </div>
          </div>
          <div class="slab-join" aria-hidden="true"></div>
          <div class="slab slab-core">
            <h3>Core</h3>
            <p>Signing, encryption, and relay communication — fast and memory-safe.</p>
          </div>
        </div>
        <ul class="why-points reveal">
          <li>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
            </svg>
            <div>
              <h3>Simple. Fast. Efficient.</h3>
              <p>Simple APIs backed by an efficient core — minimal memory use and high throughput, even under load.</p>
            </div>
          </li>
          <li>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" />
            </svg>
            <div>
              <h3>The building blocks</h3>
              <p>Keys, events, filters, relay connections — the primitives every Nostr app stands on.</p>
            </div>
          </li>
          <li>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
            </svg>
            <div>
              <h3>Open source</h3>
              <p>MIT licensed, maintained in the open, and built for the Nostr ecosystem.</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="code-title">
      <div class="section-heading reveal">
        <p class="eyebrow">Source code</p>
        <h2 id="code-title">Find the code where you are.</h2>
      </div>
      <div class="principle-grid">
        {site.repositories.map((repo) => (
          <a class="principle glow-card reveal" href={repo.url} target="_blank" rel="noopener noreferrer">
            <svg class="principle-icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {repo.name === "GitHub" && (
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z" />
              )}
              {repo.name === "GitLab" && (
                <path d="m23.6 9.593-.033-.086L20.3.98a.851.851 0 0 0-.336-.405.875.875 0 0 0-1 .054.875.875 0 0 0-.29.44l-2.207 6.748H7.533L5.327 1.07a.857.857 0 0 0-.29-.441.875.875 0 0 0-1-.054.86.86 0 0 0-.336.405L.433 9.502l-.032.086a6.066 6.066 0 0 0 2.012 7.01l.01.009.03.021 4.977 3.727 2.462 1.863 1.5 1.132a1.009 1.009 0 0 0 1.22 0l1.499-1.132 2.461-1.863 5.006-3.75.013-.01a6.068 6.068 0 0 0 2.01-7.002z" />
              )}
              {repo.name !== "GitHub" && repo.name !== "GitLab" && (
                <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 3v12" /><circle cx="18" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><path d="M18 9a9 9 0 0 1-9 9" />
                </g>
              )}
            </svg>
            <h3>{repo.name}</h3>
            <p>{repo.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="docs-section glow-card reveal" aria-labelledby="docs-title">
      <div>
        <p class="eyebrow">Documentation</p>
        <h2 id="docs-title">Go deeper in the book.</h2>
        <p class="section-text">
          The book contains installation notes, current APIs, and examples for every stack.
        </p>
      </div>
      <a class="button button-primary docs-button" href={site.docsUrl}>
        Open the book
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</Base>
