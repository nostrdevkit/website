---
import Base from "../../layouts/Base.astro";
import { withBase } from "../../utils/paths";

// One-time donation address groups — add a currency by appending an entry.
// Fields are either copyable addresses (value + label) or provider links (href).
// Example (Monero):
// {
//   currency: "Monero",
//   fields: [{ name: "address", value: "…", label: "Copy Monero address" }],
// },
const addressGroups = [
  {
    currency: "Bitcoin",
    fields: [
      { name: "on-chain", value: "bc1quk478kpm45744q5pt3p9j42fnv72ykytmt3z0j", label: "Copy on-chain donation address" },
      { name: "lightning", value: "pay@yukikishimoto.com", label: "Copy lightning address" },
      { name: "any method", href: "https://coinos.io/yuki", value: "coinos.io/yuki", label: "Open Coinos — a web wallet supporting on-chain, lightning, and more" },
    ],
  },
];
---
<Base title="Donate - Nostr Dev Kit" description="Support Nostr Dev Kit development with bitcoin donations or sustained sponsorship.">
  <main class="page">
    <section class="page-hero">
      <p class="eyebrow">Donate</p>
      <h1>Support Nostr Dev Kit development.</h1>
      <p>If these libraries power your software, services, or client applications, please consider supporting the project.</p>
    </section>

    <section class="donate-panel featured glow-card reveal" aria-labelledby="once-title">
      <div class="donate-copy">
        <svg class="card-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M9.7 7.4h3.3a1.9 1.9 0 0 1 0 3.8H9.7zM9.7 11.2h3.9a1.9 1.9 0 0 1 0 3.8H9.7zM9.7 7.4v7.6" />
          <path d="M11.4 5.4v2M13.6 5.4v2M11.4 15v2M13.6 15v2" />
        </svg>
        <h2 id="once-title">One-time.</h2>
        <p>
          Donations go straight into the development and maintenance of the libraries.
        </p>
        <p class="verify-line">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" />
          </svg>
          <span>Addresses are published in a <a href={withBase("/fund/donation-addresses.txt")}>PGP-signed declaration</a> — verify them against it before donating.</span>
        </p>
        <div class="address-list">
          {addressGroups.map((group) => (
            <div class="address-group">
              <p class="address-group-label">{group.currency}</p>
              {group.fields.map((field) =>
                field.href ? (
                  <a class="copy-field link-field" href={field.href} target="_blank" rel="noopener noreferrer" aria-label={field.label}>
                    <span class="field-name">{field.name}</span>
                    <code>{field.value}</code>
                    <svg class="ico-ext" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7M7 7h10v10" />
                    </svg>
                  </a>
                ) : (
                  <div class="copy-field" role="button" tabindex="0" data-copy={field.value} aria-label={field.label}>
                    <span class="field-name">{field.name}</span>
                    <code>{field.value}</code>
                    <svg class="ico-copy" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="9" y="9" width="13" height="13" rx="2" /><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                    </svg>
                    <svg class="ico-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </div>
                )
              )}
            </div>
          ))}
        </div>
        <p class="address-other">
          Donating a currency that's not listed, or need a fresh address? <a href={withBase("/team/")}>Write to the maintainers</a>.
        </p>
      </div>
    </section>

    <section class="donate-panel sustained glow-card reveal" aria-labelledby="sus-title">
      <div class="donate-copy">
        <svg class="card-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        <h2 id="sus-title">Sustained.</h2>
        <p>
          Building something on Nostr Dev Kit? Back the project on an ongoing basis — monthly or
          yearly — and fund its continuous development, maintenance, and long-term reliability.
        </p>
      </div>
      <div class="donate-side">
        <ul class="perk-list">
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            Priority handling of issues, fixes, and feature requests
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            A direct line with the maintainers
          </li>
          <li>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            Anything beyond, agreed case by case
          </li>
        </ul>
        <a class="button button-primary" href={withBase("/team/")}>Contact the maintainers</a>
      </div>
    </section>
  </main>
</Base>
